<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    This sandbox's network policy blocks nuget.org entirely, and even a
    project with zero PackageReferences (ApplyEngine.Domain, ApplyEngine.SelfCheck)
    still tries to contact configured sources during restore. Clearing the
    source list here makes those two projects build fully offline.

    Remove this file (or point <packageSources> back at nuget.org) once you're
    building ApplyEngine.Infrastructure / ApplyEngine.Phase0 on a machine with
    normal internet access — those DO need real package restore.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
